{
  "manifest_version": 3,
  "name": "YouTube Knowledge Extension",
  "version": "0.1.0",
  "description": "A personal knowledge layer for YouTube.",
  "action": {
    "default_title": "YouTube Knowledge"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}