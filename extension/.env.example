# These values are bundled into the extension by Vite. Use public client
# configuration only; never put server-side secrets in VITE_ variables.
# Set this to the port used by the AI Django backend, then rebuild the extension.
VITE_DJANGO_API_ORIGIN=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-or-anon-key
