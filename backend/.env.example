SECRET_KEY=replace-with-a-generated-django-secret-key
DJANGO_ENV=development
DEBUG=true

DB_NAME=youtube_knowledge
DB_USER=youtube_user
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Only needed for a Supabase project that still uses legacy HS256 signing.
# Keep this server-side secret private and unset for asymmetric signing.
SUPABASE_JWT_SECRET=

# Optional local-only bypass. It is effective only while DEBUG=true.
ENABLE_DEV_HEADER_AUTH=false

# Notes Bridge (AI backend -> Non-AI backend).
# For local testing, start the Non-AI backend at http://127.0.0.1:8001.
NOTES_SYNC_PEER_URL=http://127.0.0.1:8001
# Set the same randomly generated secret (at least 32 characters) in both backends.
NOTES_SYNC_PEER_SECRET=replace-with-the-same-random-secret-on-both-backends
# Set this to the Non-AI backend's ID from: python manage.py show_sync_installation_id
NOTES_SYNC_PEER_INSTALLATION_ID=replace-with-non-ai-installation-id
